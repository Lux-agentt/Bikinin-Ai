LLM_BASE_URL=             # base URL API penyedia, bentuknya https://.../v1 (isi dari dashboard penyedia)
LLM_API_KEY=              # rahasia, hanya di .env
BIKININ_MODEL=            # model utama untuk coding (nama persis dari daftar penyedia)
BIKININ_CHEAP_MODEL=      # model murah untuk tugas ringan
PRICE_INPUT_PER_M=        # harga USD per 1 juta token input
PRICE_OUTPUT_PER_M=       # harga USD per 1 juta token output
BIKININ_USD_IDR=17000     # hanya untuk tampilan biaya dalam rupiah
BIKININ_MAX_STEPS=30
BIKININ_MAX_COST_USD=0.50
BIKININ_WORKSPACE=./workspace
BIKININ_MAX_VIDEO_SECONDS=30   # batas durasi video Remotion (mesin 2-core lambat)

# --- Opsional: beberapa provider dengan fallback (JSON satu baris) ---
# Key TIDAK ditulis di sini; isi nama variabelnya (keyEnv) lalu set nilainya sebagai secret/env terpisah.
# Urutan = prioritas. Fallback hanya saat 429, 5xx, 402, atau gangguan jaringan, dan hanya sebelum ada teks yang tampil.
# PENTING: kalau BIKININ_PROVIDERS diisi, SEMUA keyEnv di bawah harus ada isinya — kalau satu kosong, server tidak jalan.
# Jadi: buat dulu semua key-nya, baru isi JSON ini. Kalau baru punya satu key, pakai setup LLM_* di atas saja.
# Urutan di bawah gratis dulu, berbayar terakhir — supaya saldo $2 NanoGPT awet.
# 4 model gratis OpenRouter di bawah (semua :free, semua bisa tool calling — dicek langsung dari API OpenRouter 18 Nov 2026):
# 1. or-north — cohere/north-mini-code:free — khusus coding agent, konteks 256K, tidak melatih dari prompt kamu.
# 2. or-supervl — nvidia/nemotron-3.5-super-vl:free — hasil benchmark terbaik (20/20), konteks 1M.
# 3. or-lightning — nvidia/nemotron-3.5-lightning:free — paling cepat, konteks 1M.
# 4. or-ernie — baidu/ernie-5.5-flash-preview:free — konteks 1M, klaim bagus buat coding/agent (masih preview).
# PENTING: batas 50/hari OpenRouter itu PER AKUN, bukan per model — ganti model tidak menambah jatah harian.
# Keempat model di atas berguna kalau satu model lagi down/lemot atau jelek di satu tugas; kalau jatah 50/hari
# sudah habis, semuanya kena 429 dan rantai otomatis lanjut ke Gemini (kuota gratis terpisah), lalu Nano.
# Model z-ai/glm-5.3-flash:free SUDAH TIDAK ADA di OpenRouter (dicek 18 Nov 2026) — jangan pakai ID itu.
# 5. gemini (GRATIS, tanpa kartu): key di GEMINI_API_KEY — buat di aistudio.google.com/apikey.
#    Model gemini-4-hydrogen (rilis 12 Nov 2026) — model cepat Google untuk coding + agent, konteks 1M,
#    tool calling, free tier di AI Studio, via endpoint OpenAI-compatible. Kalau model ini error/503,
#    ganti ke gemini-3.8-flash (model lama yang juga gratis).
# 6. nano (utama berbayar, saldo $2): key di NANOGPT_API_KEY — pakai nilai yang sama dengan LLM_API_KEY lama.
#    Model z-ai/glm-5.3-flash. Secret yang perlu ada di Codespaces: OPENROUTER_API_KEY,
#    NANOGPT_API_KEY, GEMINI_API_KEY, dan BIKININ_PROVIDERS (isi JSON satu baris di bawah).
# BIKININ_PROVIDERS=[{"name":"or-north","baseUrl":"https://openrouter.ai/api/v1","keyEnv":"OPENROUTER_API_KEY","model":"cohere/north-mini-code:free","inPerM":0,"outPerM":0},{"name":"or-supervl","baseUrl":"https://openrouter.ai/api/v1","keyEnv":"OPENROUTER_API_KEY","model":"nvidia/nemotron-3.5-super-vl:free","inPerM":0,"outPerM":0},{"name":"or-lightning","baseUrl":"https://openrouter.ai/api/v1","keyEnv":"OPENROUTER_API_KEY","model":"nvidia/nemotron-3.5-lightning:free","inPerM":0,"outPerM":0},{"name":"or-ernie","baseUrl":"https://openrouter.ai/api/v1","keyEnv":"OPENROUTER_API_KEY","model":"baidu/ernie-5.5-flash-preview:free","inPerM":0,"outPerM":0},{"name":"gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","keyEnv":"GEMINI_API_KEY","model":"gemini-4-hydrogen","inPerM":0,"outPerM":0},{"name":"nano","baseUrl":"https://api.nano-gpt.com/api/v1","keyEnv":"NANOGPT_API_KEY","model":"z-ai/glm-5.3-flash","inPerM":0.15,"outPerM":0.5}]
